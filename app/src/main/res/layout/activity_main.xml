<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1016"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_lock_shortcut"
        android:padding="14dp"
        android:src="@drawable/ic_mirror" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Instant Mirror"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Maintenez le bouton en bas de l'écran de verrouillage pour afficher le miroir circulaire sous la caméra."
        android:textColor="#A0A4B8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="#1B1D29"
        android:padding="16dp"
        android:textColor="#E8EAF6"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnCameraPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="1. Autoriser la caméra" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. Activer sur l'écran de verrouillage" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchTestAlways"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Afficher aussi déverrouillé (pour tester)"
        android:textColor="#D0D4E8" />

</LinearLayout>
