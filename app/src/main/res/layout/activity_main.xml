<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1016"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_lock_shortcut"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_mirror" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_title"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_subtitle"
                    android:textColor="#9AA0B8"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Statut & Permissions -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1B1D29"
            android:padding="14dp"
            android:textColor="#E8EAF6"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCameraPerm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_camera_permission" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_accessibility_service" />
        </LinearLayout>

        <!-- Option 1 : Comportement du bouton -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/section_mode"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgInteractionMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1B1D29"
            android:padding="10dp">

            <RadioButton
                android:id="@+id/rbModeHold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_hold"
                android:textColor="#E8EAF6" />

            <RadioButton
                android:id="@+id/rbModeToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_toggle"
                android:textColor="#E8EAF6" />
        </RadioGroup>

        <!-- Option 2 : Forme de la popup caméra -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_shape"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgMirrorShape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1B1D29"
            android:padding="10dp">

            <RadioButton
                android:id="@+id/rbShapeCircle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shape_circle"
                android:textColor="#E8EAF6" />

            <RadioButton
                android:id="@+id/rbShapeRoundedSq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shape_rounded_sq"
                android:textColor="#E8EAF6" />

            <RadioButton
                android:id="@+id/rbShapePill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shape_pill"
                android:textColor="#E8EAF6" />
        </RadioGroup>

        <!-- Option 3 : Cadre du miroir -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_frame"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgMirrorFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1B1D29"
            android:padding="10dp">

            <RadioButton
                android:id="@+id/rbFrameScalloped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/frame_scalloped"
                android:textColor="#E8EAF6" />

            <RadioButton
                android:id="@+id/rbFrameSmooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/frame_smooth"
                android:textColor="#E8EAF6" />

            <RadioButton
                android:id="@+id/rbFrameGold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/frame_gold"
                android:textColor="#E8EAF6" />

            <RadioButton
                android:id="@+id/rbFrameNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/frame_none"
                android:textColor="#E8EAF6" />
        </RadioGroup>

        <!-- Option 4 : Ajuster la position & taille de la popup caméra -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_popup"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResetPopupPos"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_reset" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B1D29"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvPopupOffsetY"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/popup_offset_y_label"
                android:textColor="#D0D4E8"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbPopupOffsetY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="240"
                android:progress="40" />

            <TextView
                android:id="@+id/tvPopupOffsetX"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/popup_offset_x_label"
                android:textColor="#D0D4E8"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbPopupOffsetX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="240"
                android:progress="120" />

            <TextView
                android:id="@+id/tvPopupSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/popup_size_label"
                android:textColor="#D0D4E8"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbPopupSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="200"
                android:progress="120" />
        </LinearLayout>

        <!-- Option 4 : Emplacement du bouton -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_button"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfigurePosition"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_configure_position" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1B1D29"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvButtonSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_size_label"
                android:textColor="#D0D4E8"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbButtonSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="48"
                android:progress="18" />

            <TextView
                android:id="@+id/tvButtonAlpha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/button_alpha_label"
                android:textColor="#D0D4E8"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbButtonAlpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="80"
                android:progress="80" />
        </LinearLayout>

        <!-- Mode test déverrouillé -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchTestAlways"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/switch_test_always"
            android:textColor="#D0D4E8" />

    </LinearLayout>
</ScrollView>
